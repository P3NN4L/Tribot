{
  "name": "dsh-tribot-role-picker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TriBot role picker for the DSH composer: type # and choose dispatcher / researcher / engineer / steward / reviewer / team.",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ]
}
