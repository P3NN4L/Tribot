# ===== TriBot 环境配置 =====
# 复制本文件为 .env 并填写，.env 已被 gitignore，不要把 key 贴到任何对话里

# 三家 API Key（至少填一个）
TRIBOT_GLM_API_KEY=
TRIBOT_MINIMAX_API_KEY=
TRIBOT_DEEPSEEK_API_KEY=

# 联网搜索（可选，tavily.com 免费注册，每月 1000 次）
TRIBOT_TAVILY_API_KEY=

# 数据目录（可选；默认 <项目>/data，打包版为 %APPDATA%/TriBot）
# TRIBOT_DATA_DIR=

# 本地服务端口（可选，默认 47615）
# TRIBOT_PORT=47615
